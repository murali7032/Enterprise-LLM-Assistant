# Copy to .env and fill in values. Never commit .env.

LLM_PROVIDER=gemini

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

MODEL_NAME=gemini-2.5-flash
TEMPERATURE=0.2

# Embeddings for RAG (defaults to LLM_PROVIDER when EMBEDDING_PROVIDER is empty)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Conversation memory / context window
MEMORY_ENABLED=true
MEMORY_MAX_MESSAGES=10
MEMORY_MAX_CHARS=8000

# Redis cache (LLM response caching) + session store
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
SESSION_BACKEND=memory
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=1209600
AUTH_DEV_TOKEN_ENABLED=false
APP_PUBLIC_URL=http://localhost:8000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL (repository layer)
USE_POSTGRES=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_platform

# Chat uploads: auto-delete from Qdrant/Postgres when session ends
EPHEMERAL_CHAT_DOCUMENTS=true
